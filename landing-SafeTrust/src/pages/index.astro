---
import HeroSection from "../components/Hero/HeroSection.astro";
import OurPromise from "../components/OurPromise.astro";
import DiscoverSafeTrust from "../components/Features/DiscoverSafeTrust.astro";
import KeyBenefits from "../components/Features/KeyBenefits.astro";
import HowItWorksSection from "../components/HowItWorks/HowItWorksSection.astro";
import BookWithEscrow from "../components/BookWithEscrow/BookWithEscrow.astro";
import SecuritySection from "../components/SecuritySection.astro";
import Contributors from "../components/Contributors.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import "../styles/theme.css";
import "../styles/glass.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/landing-logo.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>SafeTrust — Rental escrow for homes and hotels on Stellar</title>
    <meta
      name="description"
      content="Book homes and hotels with rent and deposits held in a smart contract on Stellar. Hosts are paid after check-in, guests get their deposit back after check-out."
    />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        const stored = localStorage.getItem("theme");
        const dark = stored === "dark" || (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body>
    <HeroSection />
    <OurPromise />
    <BookWithEscrow />
    <DiscoverSafeTrust />
    <KeyBenefits />
    <HowItWorksSection />
    <SecuritySection />
    <Contributors />
    <FinalCTA />
    <Footer />
  </body>
</html>
