---
import HeroSection from "../components/Hero/HeroSection.astro";
import OurPromise from "../components/OurPromise.astro";
import DiscoverSafeTrust from "../components/Features/DiscoverSafeTrust.astro";
import KeyBenefits from "../components/Features/KeyBenefits.astro";
import HowItWorksSection from "../components/HowItWorks/HowItWorksSection.astro";
import SecuritySection from "../components/SecuritySection.astro";
import Contributors from "../components/Contributors.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import "../styles/theme.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/landing-logo.jpeg" />
    <title>SafeTrust — Secure P2P Escrow on Stellar</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        const stored = localStorage.getItem("theme");
        const dark = stored === "dark" || (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body>
    <HeroSection />
    <OurPromise />
    <DiscoverSafeTrust />
    <KeyBenefits />
    <HowItWorksSection />
    <SecuritySection />
    <Contributors />
    <FinalCTA />
    <Footer />

    <script is:inline>
      const themeToggle = document.getElementById("theme-toggle");
      const storedTheme = window.localStorage.getItem("safeTrust-theme");
      const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = storedTheme ? storedTheme === "dark" : systemPrefersDark;

      document.documentElement.classList.toggle("dark", isDark);

      const updateToggle = () => {
        if (!themeToggle) return;
        const darkEnabled = document.documentElement.classList.contains("dark");
        themeToggle.setAttribute("aria-pressed", String(darkEnabled));
        themeToggle.title = darkEnabled ? "Switch to light mode" : "Switch to dark mode";
        themeToggle.textContent = darkEnabled ? "☀️" : "🌙";
      };

      updateToggle();

      themeToggle?.addEventListener("click", () => {
        const darkEnabled = document.documentElement.classList.toggle("dark");
        window.localStorage.setItem("safeTrust-theme", darkEnabled ? "dark" : "light");
        updateToggle();
      });
    </script>
  </body>
</html>