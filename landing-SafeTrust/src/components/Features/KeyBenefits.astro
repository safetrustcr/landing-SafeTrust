---
import InteractiveFeatures from './CategoryTabs.jsx';
import GlassBackdrop from '../GlassBackdrop.astro';
import "../../styles/KeyBenefits.css";
---

<section class="kb-section">
  <GlassBackdrop variant="left" />
  <div class="kb-container">
    
    <header class="kb-header">
      <div class="eyebrow-pill kb-eyebrow-pill">WHY SAFETRUST</div>
      <h2 class="kb-title">
        Key benefits for <span class="kb-italic-accent">guests and hosts</span>
      </h2>
      <p class="kb-subtitle">
        Eight reasons to rent with SafeTrust instead of sending money to a stranger.
      </p>
    </header>

    {/* Load the complete interactive layout component directly onto the page */}
    <InteractiveFeatures client:visible />

  </div>
</section>