---
import GlassPanel from "./GlassPanel.tsx";
---
<section class="final-cta-section">
  <div class="cta-bg-gradient"></div>
  <div class="cta-bg-overlay"></div>
  
  <div class="cta-glass-wrap">
  <GlassPanel client:visible className="cta-glass">
  <div class="cta-content">
    <div class="eyebrow-container">
      <span class="eyebrow-pill final-cta-eyebrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
        Start Your Journey
      </span>
    </div>

    <h2 class="cta-heading">
      Ready to book your next stay<br/>
      <span class="italic text-purple-accent">with escrow?</span>
    </h2>

    <p class="cta-description">
      Guests get their deposit back without chasing anyone. Hosts get paid as soon as check-in is confirmed. Connect your wallet and get started in minutes.
    </p>

    <div class="cta-actions">
      <button class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a8 8 0 0 1-8 8H5a2 2 0 0 1-2-2V5"/><path d="M17 11.5v.5"/><path d="M17 15.5v-.5"/></svg>
        Connect Wallet &rarr;
      </button>
      <button class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Read the Docs &rarr;
      </button>
    </div>

    <div class="cta-stats">
      <div class="stat-item">
        <span class="dot dot-green"></span>
        10,000+ Active Users
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="dot dot-blue"></span>
        $50M+ Secured
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="dot dot-purple"></span>
        99.9% Uptime
      </div>
    </div>
  </div>
  </GlassPanel>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding: 5rem 1rem;
    overflow: hidden;
    text-align: center;
    background: var(--background);
  }
  @media (min-width: 768px) {
    .final-cta-section {
      padding: 7rem 2rem;
    }
  }

  .final-cta-section {
    border-radius: 1.5rem;
    margin: 0 1.5rem;
  }
  @media (min-width: 768px) {
    .final-cta-section {
      margin: 0 2rem;
    }
  }

  :global(html.dark) .final-cta-section {
    border-radius: 0;
    margin: 0;
    box-shadow: 0 0 80px var(--orange-glow-soft);
  }

  .cta-bg-gradient {
    position: absolute;
    inset: 0;
    background: var(--cta-section-bg);
    z-index: 1;
    border-radius: inherit;
  }

  :global(html.dark) .cta-bg-gradient {
    opacity: 0.85;
  }

  .cta-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--brand-deep-alpha), transparent);
    z-index: 2;
    border-radius: inherit;
  }

  .cta-glass-wrap {
    position: relative;
    z-index: 10;
    max-width: 56rem;
    margin: 0 auto;
  }

  /* Deep-blue tint inside the glass keeps the white text readable in both themes */
  .cta-glass-wrap :global(.glass-surface.cta-glass) {
    background-color: var(--brand-deep-glass);
    box-shadow:
      inset 0 1px 0 var(--on-dark-faint),
      inset 0 0 0 1px var(--border-on-dark-subtle),
      0 30px 80px -30px var(--shadow-lg);
  }

  .cta-content {
    position: relative;
    z-index: 10;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-container {
    margin-bottom: 1.5rem;
  }

  .final-cta-eyebrow {
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--brand-glow-medium);
    border: 1px solid var(--brand-glow-strong);
    color: var(--brand-light);
    font-weight: 600;
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .cta-content {
      padding: 2.25rem 1.25rem;
    }
  }

  .cta-heading::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 3px;
    margin: 1rem auto 0;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--brand-soft), var(--orange-vivid));
  }

  .cta-heading {
    font-size: 2.25rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--on-dark);
    text-shadow: 0 2px 8px color-mix(in srgb, var(--brand-deep) 55%, transparent);
    margin: 0 0 1.5rem 0;
  }
  @media (min-width: 768px) {
    .cta-heading {
      font-size: 3.75rem;
    }
  }

  .text-purple-accent {
    font-style: italic;
    background: var(--accent-text-on-dark);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
  }

  .cta-description {
    font-size: 1.125rem;
    color: var(--on-dark-muted);
    text-shadow: 0 1px 2px color-mix(in srgb, var(--brand-deep) 70%, transparent);
    max-width: 42rem;
    margin: 0 0 2.5rem 0;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    justify-content: center;
  }
  @media (min-width: 640px) {
    .cta-actions {
      flex-direction: row;
      width: auto;
    }
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1.125rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(to right, var(--brand-solid), var(--brand-solid-hover));
    color: var(--on-brand);
    border: none;
    box-shadow: 0 4px 14px 0 color-mix(in srgb, var(--brand-accent) 39%, transparent);
  }
  .btn-primary:hover {
    transform: scale(1.02);
  }

  .btn-secondary {
    background: transparent;
    color: var(--on-dark);
    border: 2px solid var(--on-dark-border);
  }
  .btn-secondary:hover {
    border-color: var(--brand-accent);
    background: color-mix(in srgb, var(--brand-accent) 8%, transparent);
    transform: scale(1.02);
  }

  .cta-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 3rem;
    color: var(--on-dark-subtle);
    font-size: 0.875rem;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-divider {
    display: none;
    width: 1px;
    height: 1rem;
    background: var(--card-border);
  }
  @media (min-width: 640px) {
    .stat-divider {
      display: block;
    }
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  .dot-green { background-color: var(--success-bright); }
  .dot-blue { background-color: var(--brand-mid); }
  .dot-purple { background-color: var(--orange-vivid); }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>