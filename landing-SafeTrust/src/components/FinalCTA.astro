---
import GlassPanel from "./GlassPanel.tsx";
import ConnectWalletButton from "./ConnectWalletButton";
---
<section class="final-cta-section">
  <div class="cta-bg-gradient"></div>
  <div class="cta-bg-overlay"></div>
  
  <div class="cta-glass-wrap">
  <GlassPanel client:visible className="cta-glass">
  <div class="cta-content">
    <div class="eyebrow-container">
      <span class="eyebrow-pill">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
        Start Your Journey
      </span>
    </div>

    <h2 class="cta-heading">
      Ready to book your next stay<br/>
      <span class="italic text-purple-accent">with escrow?</span>
    </h2>

    <p class="cta-description">
      Guests get their deposit back without chasing anyone. Hosts get paid as soon as check-in is confirmed. Connect your wallet and get started in minutes.
    </p>

    <div class="cta-actions">
      <ConnectWalletButton
        client:load
        buttonClassName="btn-primary"
        controlClassName="final-wallet-control"
        installClassName="final-wallet-install"
        errorClassName="final-wallet-error"
        label="Connect Wallet"
      />
      <button class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Read the Docs &rarr;
      </button>
    </div>

    <div class="cta-stats">
      <div class="stat-item">
        <span class="dot dot-green"></span>
        10,000+ Active Users
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="dot dot-blue"></span>
        $50M+ Secured
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="dot dot-purple"></span>
        99.9% Uptime
      </div>
    </div>
  </div>
  </GlassPanel>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding: 5rem 1rem;
    overflow: hidden;
    text-align: center;
    background: var(--background);
  }
  @media (min-width: 768px) {
    .final-cta-section {
      padding: 7rem 2rem;
    }
  }

  .final-cta-section {
    border-radius: 1.5rem;
    margin: 0 1.5rem;
  }
  @media (min-width: 768px) {
    .final-cta-section {
      margin: 0 2rem;
    }
  }

  :global(html.dark) .final-cta-section {
    border-radius: 0;
    margin: 0;
    box-shadow: 0 0 80px var(--orange-glow-soft);
  }

  .cta-bg-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 85% 85%, rgba(249, 115, 22, 0.22), transparent 38%),
      radial-gradient(circle at 15% 10%, rgba(59, 130, 246, 0.35), transparent 45%),
      linear-gradient(135deg, #0b1533 0%, #1e3a8a 55%, #0b1533 100%);
    z-index: 1;
    border-radius: inherit;
  }

  :global(html.dark) .cta-bg-gradient {
    opacity: 0.85;
  }

  .cta-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 21, 51, 0.45), transparent);
    z-index: 2;
    border-radius: inherit;
  }

  .cta-glass-wrap {
    position: relative;
    z-index: 10;
    max-width: 56rem;
    margin: 0 auto;
  }

  /* Deep-blue tint inside the glass keeps the white text readable in both themes */
  .cta-glass-wrap :global(.glass-surface.cta-glass) {
    background-color: rgba(11, 21, 51, 0.32);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      0 30px 80px -30px rgba(2, 6, 23, 0.6);
  }

  .cta-content {
    position: relative;
    z-index: 10;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-container {
    margin-bottom: 1.5rem;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(147, 197, 253, 0.14);
    border: 1px solid rgba(147, 197, 253, 0.35);
    border-radius: 9999px;
    color: #bfdbfe;
    font-weight: 600;
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .cta-content {
      padding: 2.25rem 1.25rem;
    }
  }

  .cta-heading::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 3px;
    margin: 1rem auto 0;
    border-radius: 3px;
    background: linear-gradient(90deg, #60a5fa, #f97316);
  }

  .cta-heading {
    font-size: 2.25rem;
    line-height: 1.2;
    font-weight: 700;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    margin: 0 0 1.5rem 0;
  }
  @media (min-width: 768px) {
    .cta-heading {
      font-size: 3.75rem;
    }
  }

  .text-purple-accent {
    font-style: italic;
    background: linear-gradient(90deg, #93c5fd, #60a5fa 80%, #fb923c 94%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
  }

  .cta-description {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    max-width: 42rem;
    margin: 0 0 2.5rem 0;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    justify-content: center;
  }
  @media (min-width: 640px) {
    .cta-actions {
      flex-direction: row;
      width: auto;
    }
  }

  :global(.btn-primary), .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1.125rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.btn-primary) {
    background: linear-gradient(to right, var(--brand-primary), var(--brand-accent));
    color: white;
    border: none;
    box-shadow: 0 4px 14px 0 color-mix(in srgb, var(--brand-accent) 39%, transparent);
  }
  :global(.btn-primary:disabled) {
    cursor: wait;
    opacity: 0.8;
  }

  .final-wallet-control {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
  }

  .final-wallet-install,
  .final-wallet-error {
    color: #ffffff;
    font-size: 0.875rem;
  }

  .final-wallet-error {
    color: #fecaca;
  }

  @media (min-width: 640px) {
    .final-wallet-control {
      width: auto;
    }
  }
  :global(.btn-primary:hover) {
    transform: scale(1.02);
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.5);
  }
  .btn-secondary:hover {
    border-color: var(--brand-accent);
    background: color-mix(in srgb, var(--brand-accent) 8%, transparent);
    transform: scale(1.02);
  }

  .cta-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 3rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.875rem;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-divider {
    display: none;
    width: 1px;
    height: 1rem;
    background: var(--card-border);
  }
  @media (min-width: 640px) {
    .stat-divider {
      display: block;
    }
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  .dot-green { background-color: #22c55e; }
  .dot-blue { background-color: #3b82f6; }
  .dot-purple { background-color: #f97316; }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>