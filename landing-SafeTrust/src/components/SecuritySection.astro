---
// SecuritySection.astro
import SecurityCard from './SecurityCard.astro';
import GlassBackdrop from './GlassBackdrop.astro';
import '../styles/security.css';
---

<section class="security-section">
  <GlassBackdrop variant="left" />
  <!-- Heading Block -->
  <h2 class="security-title">Security for every stay</h2>
  <p class="security-subtitle">Protection for guest and host, from booking to check-out.</p>

  <!-- Responsive Cards Grid -->
  <div class="security-grid">
    <SecurityCard
      title="Funds locked by smart contract"
      description="Neither the guest, the host, nor SafeTrust can move the money alone."
      iconType="lock"
      themeClass="theme-green"
      borderClass="border-primary"
      score="Open source"
      scoreColorClass="color-green"
      certs="Audit planned"
    />
    <SecurityCard
      title="Wallet signatures"
      description="Guests and hosts approve each step with their own wallet. No passwords or card numbers to leak."
      iconType="key"
      themeClass="theme-blue"
      borderClass="border-accent"
      score="User approved"
      scoreColorClass="color-blue"
      certs="Non-custodial flow"
    />
    <SecurityCard
      title="Open, checkable records"
      description="Every booking step is recorded on Stellar, so both sides can verify it."
      iconType="radar"
      themeClass="theme-navy"
      borderClass="border-primary"
      score="On-chain"
      scoreColorClass="color-green"
      certs="Stellar testnet"
    />
  </div>
</section>
