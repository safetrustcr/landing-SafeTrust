---
// src/components/HowItWorks/HowItWorksSection.astro
import Stepper from "./Stepper.jsx";
import GlassBackdrop from "../GlassBackdrop.astro";
import "../../styles/stepper.css";

const STEPS = [
  { id: 1, title: "Guest books", description: "Rent and deposit are locked in escrow at booking.", status: "completed" },
  { id: 2, title: "Held on-chain", description: "The money waits in the contract. No one can take it alone.", status: "completed" },
  { id: 3, title: "Check-in confirmed", description: "Guest and host both confirm the check-in.", status: "in-progress" },
  { id: 4, title: "Auto-released", description: "Host gets paid. The deposit returns to the guest after check-out.", status: "pending" },
];

const STATUS_CONFIG = {
  completed: { label: "COMPLETED" },
  "in-progress": { label: "IN PROGRESS" },
  pending: { label: "PENDING" },
};
---

<section id="how-it-works" class="hiw-section" aria-label="How a SafeTrust rental escrow works">
  <div class="hiw-progress-bar" data-progress-bar></div>
  <GlassBackdrop variant="center" />

  <div class="hiw-header" data-header>
    <p class="eyebrow-pill hiw-eyebrow-pill">HOW IT WORKS</p>
    <h2>Four steps. <em>Zero middlemen.</em></h2>
    <p class="hiw-subtitle">From booking to check-out — every stay follows the same transparent flow.</p>
  </div>

  <div class="hiw-stepper-card glass-card">
    <div class="hiw-timeline">
      {Array.from({ length: STEPS.length * 2 - 1 }).map((_, i) => {
        if (i % 2 === 0) {
          const stepIndex = i / 2;
          const step = STEPS[stepIndex];
          const cfg = STATUS_CONFIG[step.status];
          return (
            <div class="hiw-step-node" data-step-node>
              <div
                class={`hiw-node-circle ${step.status}`}
                data-node-circle
                data-status={step.status}
              >
                {step.status !== "completed" && (
                  <span class={`hiw-node-ring hiw-node-ring--${step.status}`} aria-hidden="true"></span>
                )}
                <span class="hiw-node-icon" data-node-icon>
                  {step.status === "completed" ? (
                    <svg
                      class="hiw-node-checkmark"
                      data-checkmark
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  ) : (
                    step.id
                  )}
                </span>
              </div>
              <div class="hiw-step-content">
                <span
                  class={`hiw-status-chip ${step.status}`}
                  data-status-chip
                  data-status={step.status}
                >
                  {step.status === "in-progress" && (
                    <span class="hiw-chip-live-dot" aria-hidden="true"></span>
                  )}
                  {cfg.label}
                  {step.status === "pending" && (
                    <span class="hiw-chip-wait-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  )}
                </span>
                <p class="hiw-step-title">{step.title}</p>
                <p class="hiw-step-desc">{step.description}</p>
              </div>
            </div>
          );
        }

        const prevStatus = STEPS[(i - 1) / 2].status;
        const nextStatus = STEPS[(i + 1) / 2].status;
        const waiting = prevStatus === "in-progress" && nextStatus === "pending";
        return (
          <div class={`hiw-connector${waiting ? " hiw-connector--waiting" : ""}`} data-connector>
            <div class="hiw-connector-fill" data-connector-fill></div>
            <div class="hiw-connector-glow" data-connector-glow></div>
          </div>
        );
      })}
    </div>
  </div>

  <div class="hiw-cta">
    <p>Want to see it with a real booking?</p>
    <a href="#book-with-escrow" class="hiw-cta-btn">Try a booking →</a>
  </div>
</section>

<Stepper client:load />
