---
// src/components/HowItWorks/HowItWorksSection.astro
import Stepper from "./Stepper.jsx";
import "../../styles/stepper.css";

const STEPS = [
  { id: 1, title: "Funds locked", description: "Funds locked into the escrow on booking.", status: "completed" },
  { id: 2, title: "Held on-chain", description: "Held on-chain securely while active.", status: "completed" },
  { id: 3, title: "Both confirm", description: "Both parties confirm to trigger release.", status: "in-progress" },
  { id: 4, title: "Auto-released", description: "Smart contract releases funds automatically.", status: "pending" },
];

const STATUS_CONFIG = {
  completed: { label: "COMPLETED" },
  "in-progress": { label: "IN PROGRESS" },
  pending: { label: "PENDING" },
};
---

<section id="how-it-works" class="how-it-works" aria-label="How SafeTrust Escrow Works">
  <div class="progress-bar" data-progress-bar></div>

  <div class="section-header" data-header>
    <p class="eyebrow-pill">HOW IT WORKS</p>
    <h2>Four steps. <em>Zero middlemen.</em></h2>
    <p class="subtitle">From booking to release — every escrow follows the same transparent flow.</p>
  </div>

  <div class="stepper-card">
    <div class="timeline">
      {Array.from({ length: STEPS.length * 2 - 1 }).map((_, i) => {
        if (i % 2 === 0) {
          const stepIndex = i / 2;
          const step = STEPS[stepIndex];
          const cfg = STATUS_CONFIG[step.status];
          return (
            <div class="step-node" data-step-node>
              <div
                class={`node-circle ${step.status}`}
                data-node-circle
                data-status={step.status}
              >
                <span class="node-icon" data-node-icon>
                  {step.status === "completed" ? (
                    <svg
                      class="node-checkmark"
                      data-checkmark
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  ) : (
                    step.id
                  )}
                </span>
              </div>
              <div class="step-content">
                <span
                  class={`status-chip ${step.status}`}
                  data-status-chip
                  data-status={step.status}
                >
                  {cfg.label}
                </span>
                <p class="step-title">{step.title}</p>
                <p class="step-desc">{step.description}</p>
              </div>
            </div>
          );
        }

        return (
          <div class="connector" data-connector>
            <div class="connector-fill" data-connector-fill></div>
            <div class="connector-glow" data-connector-glow></div>
          </div>
        );
      })}
    </div>
  </div>

  <div class="cta">
    <p>Ready to secure your transactions?</p>
    <a href="#our-promise" class="cta-btn">Get Started →</a>
  </div>
</section>

<Stepper client:load />
