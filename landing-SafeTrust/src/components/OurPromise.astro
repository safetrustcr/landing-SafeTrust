---
import { Icon } from "astro-icon/components";
import ConnectWalletCTA from "./ConnectWalletCTA";

const guarantees = [
  {
    title: "Rent and deposit held in a smart contract",
    tag: "soroban",
    desc: "From booking to check-out the money stays in on-chain escrow — not with the host, and not with us.",
    icon: "lucide:shield-check",
    tone: "primary",
  },
  {
    title: "Released only when guest and host agree",
    tag: "2/2 sig",
    desc: "The host is paid once check-in is confirmed. The deposit goes back to the guest after check-out.",
    icon: "lucide:users",
    tone: "accent",
  },
  {
    title: "Fair damage claims",
    tag: "on-chain",
    desc: "If something goes wrong, claims follow rules and evidence that both guest and host can see.",
    icon: "lucide:scale",
    tone: "emerald",
  },
];

const miniBadges = [
  { label: "Deposit protection", icon: "lucide:shield-check", tone: "primary" },
  { label: "No card details shared", icon: "lucide:lock", tone: "accent" },
  { label: "Paid in stablecoins", icon: "lucide:coins", tone: "gold" },
];
---

<section class="our-promise" id="our-promise">
  <div class="our-promise__backdrop" aria-hidden="true">
    <div class="our-promise__glow our-promise__glow--left"></div>
    <div class="our-promise__glow our-promise__glow--right"></div>
  </div>

  <div class="our-promise__grid">
    <div class="our-promise__content">
      <p class="our-promise__eyebrow">Our promise</p>
      <h2 class="our-promise__headline">
        Fair for guests. <em>Safe for hosts.</em>
      </h2>
      <p class="our-promise__description">
        Rent and deposits wait in a decentralized escrow until guest and host both confirm.
        Guests know their deposit comes back. Hosts know the money is really there before they
        hand over the keys. And anyone can check the rules in the code.
      </p>

      <ConnectWalletCTA client:visible />

      <div class="our-promise__badges" aria-label="Platform trust signals">
        {miniBadges.map((badge) => (
          <span class={`our-promise__badge our-promise__badge--${badge.tone}`}>
            <span class="our-promise__badge-icon" aria-hidden="true">
              <Icon name={badge.icon} width="15" height="15" />
            </span>
            {badge.label}
          </span>
        ))}
      </div>
    </div>

    <div class="our-promise__card-shell">
      <span class="our-promise__verified-badge">
        <span class="our-promise__verified-label">Verified on-chain</span>
        <span class="our-promise__verified-version">
          <span class="our-promise__live-dot" aria-hidden="true"></span>
          Stellar
        </span>
      </span>

      <div class="our-promise__card glass-card">
        <p class="our-promise__card-eyebrow">Every booking includes</p>

        <div class="our-promise__guarantees">
          {guarantees.map((guarantee) => (
            <div class="our-promise__guarantee">
              <div class={`our-promise__guarantee-icon our-promise__guarantee-icon--${guarantee.tone}`}>
                <Icon name={guarantee.icon} width="20" height="20" />
              </div>
              <div class="our-promise__guarantee-copy">
                <div class="our-promise__guarantee-header">
                  <strong>{guarantee.title}</strong>
                  <span class="our-promise__tag">{guarantee.tag}</span>
                </div>
                <p>{guarantee.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .our-promise {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4.5rem, 8vw, 7rem) 1.5rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand-accent) 4%, transparent),
      color-mix(in srgb, var(--orange) 2.5%, transparent)
    );
  }

  .our-promise::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--promise-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--promise-grid) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: linear-gradient(to bottom, color-mix(in srgb, black 55%, transparent), transparent 92%);
    pointer-events: none;
  }

  .our-promise__backdrop {
    position: absolute;
    inset: 0;
    z-index: -3;
    pointer-events: none;
  }

  .our-promise__glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(80px);
    opacity: 0.55;
  }

  .our-promise__glow--left {
    width: 18rem;
    height: 18rem;
    left: -4rem;
    top: 2rem;
    background: var(--brand-glow-medium);
  }

  .our-promise__glow--right {
    width: 20rem;
    height: 20rem;
    right: -6rem;
    bottom: -3rem;
    background: var(--orange-glow-soft);
  }

  .our-promise__grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .our-promise__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .our-promise__content {
    position: relative;
  }

  .our-promise__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--brand-primary);
    opacity: 0;
    transform: translateY(12px);
    animation: eyebrowReveal 0.75s ease-out forwards;
  }

  .our-promise__eyebrow::before {
    content: "";
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--brand-primary) 25%, transparent),
      var(--brand-primary) 70%,
      var(--orange-vivid)
    );
    transform-origin: left center;
    animation: eyebrowLine 0.75s ease-out forwards;
  }

  .our-promise__headline {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--foreground);
    text-wrap: balance;
  }

  .our-promise__headline em {
    font-style: italic;
    color: transparent;
    background: var(--accent-text);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .our-promise__description {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--muted-foreground);
  }

  .our-promise__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 1.75rem;
  }

  .our-promise__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--brand-tint-border);
    border-radius: 999px;
    background: var(--glass-bg);
    box-shadow: 0 10px 24px -18px color-mix(in srgb, var(--foreground) 40%, transparent);
    backdrop-filter: blur(10px);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--foreground-secondary);
  }

  .our-promise__badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .our-promise__badge--primary .our-promise__badge-icon {
    background: var(--brand-glow-medium);
    color: var(--brand-primary);
  }

  .our-promise__badge--accent .our-promise__badge-icon {
    background: var(--brand-glow-medium);
    color: var(--brand-accent);
  }

  .our-promise__badge--gold .our-promise__badge-icon {
    background: var(--warning-tint);
    color: var(--warning-strong);
  }

  .our-promise__card-shell {
    position: relative;
    padding-top: 1.5rem;
  }

  .our-promise__verified-badge {
    position: absolute;
    top: 0;
    right: 1.25rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--brand-deep) 95%, transparent);
    box-shadow: 0 18px 36px -20px var(--brand-deep);
    color: var(--on-dark);
    backdrop-filter: blur(16px);
  }

  .our-promise__verified-label {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .our-promise__verified-version {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--brand-light);
  }

  .our-promise__live-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--success-bright);
    animation: pulseDot 1.8s ease-out infinite;
  }

  .our-promise__card {
    position: relative;
    overflow: hidden;
    padding: 2rem 1.5rem 1.5rem;
    border: 1px solid var(--brand-tint-border);
    border-radius: 1.5rem;
    background:
      linear-gradient(180deg, var(--glass-hi), color-mix(in srgb, var(--surface-white) 70%, transparent)),
      radial-gradient(circle at top left, color-mix(in srgb, var(--brand-light) 28%, transparent), transparent 42%);
    box-shadow: 0 20px 40px -12px var(--brand-glow-soft);
    backdrop-filter: blur(16px);
  }

  .our-promise__card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--border-on-dark-subtle), transparent 42%);
    pointer-events: none;
  }

  .our-promise__card-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .our-promise__guarantees {
    display: grid;
    gap: 0.9rem;
  }

  .our-promise__guarantee {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .our-promise__guarantee:first-child {
    border-top: none;
    padding-top: 0;
  }

  .our-promise__guarantee-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 0.9rem;
    box-shadow: inset 0 1px 0 var(--glass-sweep);
  }

  .our-promise__guarantee-icon--primary {
    background: linear-gradient(
      135deg,
      var(--brand-glow-medium),
      color-mix(in srgb, var(--brand-soft) 24%, transparent)
    );
    color: var(--brand-primary);
  }

  .our-promise__guarantee-icon--accent {
    background: linear-gradient(
      135deg,
      var(--brand-glow-medium),
      color-mix(in srgb, var(--brand-soft) 22%, transparent)
    );
    color: var(--brand-accent);
  }

  .our-promise__guarantee-icon--emerald {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--success) 18%, transparent),
      color-mix(in srgb, var(--success-bright) 20%, transparent)
    );
    color: var(--success-strong);
  }

  .our-promise__guarantee-copy strong {
    font-size: 1rem;
    color: var(--foreground);
  }

  .our-promise__guarantee-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.35rem;
  }

  .our-promise__tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--brand-tint-border);
    border-radius: 999px;
    background: var(--brand-tint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--brand-primary);
    text-transform: lowercase;
  }

  .our-promise__guarantee-copy p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  :global(.connect-wallet-cta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  :global(.connect-wallet-cta__action) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  :global(.connect-wallet-cta__action:hover) {
    transform: translateY(-1px);
  }

  :global(.connect-wallet-cta__action:focus-visible) {
    outline: 2px solid var(--orange-vivid);
    outline-offset: 3px;
  }

  :global(.connect-wallet-cta__action--primary) {
    border: 1px solid var(--border-hairline);
    background: linear-gradient(135deg, var(--brand-deep), var(--brand-solid) 68%, var(--brand-solid-hover));
    box-shadow: 0 16px 30px -18px var(--brand-primary-glow);
    color: var(--on-brand);
    cursor: pointer;
  }

  :global(.connect-wallet-cta__action--primary:disabled) {
    opacity: 0.8;
    cursor: wait;
    transform: none;
  }

  :global(.connect-wallet-cta__action--secondary) {
    border: 1px solid var(--brand-tint-border);
    background: var(--surface-overlay);
    color: var(--brand-primary);
    box-shadow: 0 10px 24px -18px var(--shadow-md);
  }

  :global(.connect-wallet-cta__icon) {
    display: inline-flex;
    flex-shrink: 0;
  }

  :global(.connect-wallet-cta__action--secondary:hover) {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
  }

  @media (max-width: 767px) {
    .our-promise {
      padding-inline: 1rem;
    }

    .our-promise__badge {
      width: 100%;
      justify-content: flex-start;
    }

    .our-promise__verified-badge {
      position: static;
      margin-bottom: 1rem;
      width: fit-content;
    }

    .our-promise__card-shell {
      padding-top: 0;
    }

    :global(.connect-wallet-cta__action) {
      width: 100%;
    }
  }

  @keyframes eyebrowReveal {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes eyebrowLine {
    from { transform: scaleX(0.15); opacity: 0.35; }
    to { transform: scaleX(1); opacity: 1; }
  }

  @keyframes pulseDot {
    0% { box-shadow: 0 0 0 0 var(--success-pulse); }
    70% { box-shadow: 0 0 0 10px color-mix(in srgb, var(--success-bright) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--success-bright) 0%, transparent); }
  }

  /* Dark mode — keep glassmorphism without near-white surfaces */
  :global(html.dark) .our-promise {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand-primary) 10%, transparent),
      color-mix(in srgb, var(--orange) 4%, transparent)
    );
  }

  :global(html.dark) .our-promise__glow--left {
    background: var(--brand-glow-medium);
    opacity: 0.7;
  }

  :global(html.dark) .our-promise__glow--right {
    background: var(--brand-glow-medium);
    opacity: 0.7;
  }

  :global(html.dark) .our-promise__headline {
    color: var(--foreground-strong);
  }

  :global(html.dark) .our-promise__badge {
    background: var(--surface-overlay);
    border-color: var(--border-subtle);
    color: var(--foreground-secondary);
    box-shadow: 0 10px 24px -18px var(--shadow-lg);
  }

  :global(html.dark) .our-promise__card {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--surface-elevated) 90%, transparent),
      color-mix(in srgb, var(--card-bg) 85%, transparent)
    );
    border-color: var(--border-subtle);
    box-shadow: 0 20px 40px -12px var(--shadow-lg);
  }

  :global(html.dark) .our-promise__card::after {
    background: linear-gradient(135deg, var(--glass-hi-soft), transparent 42%);
  }

  :global(html.dark) .our-promise__guarantee-copy strong {
    color: var(--foreground-strong);
  }

  :global(html.dark) .our-promise__tag {
    background: var(--brand-glow-soft);
    border-color: var(--brand-tint-border);
    color: var(--brand-light);
  }

  :global(html.dark) .our-promise :global(.connect-wallet-cta__action--secondary) {
    background: var(--surface-overlay);
    border-color: var(--border-input);
    color: var(--brand-soft);
    box-shadow: none;
  }

  :global(html.dark) .our-promise :global(.connect-wallet-cta__action--secondary:hover) {
    border-color: var(--brand-glow-strong);
    color: var(--brand-light);
  }
</style>