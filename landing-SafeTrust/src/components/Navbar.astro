---
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  { label: "Features", href: "#features" },
  { label: "How It Works", href: "#how-it-works" },
  { label: "Pricing", href: "#pricing" },
  { label: "Use case · Rentals & stays", href: "#book-with-escrow" },
  { label: "Contributors", href: "#contributors" },
];
---

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/logo-64.png" alt="SafeTrust logo" width="32" height="32" />
    <span>SafeTrust</span>
  </a>

  <input type="checkbox" id="nav-toggle" class="navbar-checkbox" aria-label="Toggle navigation" />
  <label for="nav-toggle" class="navbar-toggle" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <div class="navbar-links">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}

    <a href="/register" class="navbar-cta mobile-cta">
      Connect Wallet
    </a>
  </div>

  <div class="navbar-actions">
    <ThemeToggle />
    <a href="/register" class="navbar-cta">Connect Wallet</a>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 2rem;
    backdrop-filter: blur(16px);
    background: var(--surface-navbar);
    border-bottom: 1px solid var(--border-hairline);
    box-shadow: 0 1px 12px var(--shadow-sm);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--foreground);
    text-decoration: none;
  }

  .navbar-brand img {
    border-radius: 8px;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .navbar-links a {
    color: var(--foreground);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .theme-toggle {
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--foreground);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px var(--shadow-color);
  }

  .navbar-links a:hover {
    color: var(--brand-primary);
  }

  @media (min-width: 1024px) {
    .navbar-links a {
      position: relative;
    }

    .navbar-links a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -6px;
      height: 2px;
      border-radius: 2px;
      background: linear-gradient(90deg, var(--brand-primary), var(--orange-vivid));
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.25s ease;
    }

    .navbar-links a:hover::after {
      transform: scaleX(1);
    }
  }

  .navbar-cta {
    display: inline-block;
    background: var(--surface-white);
    color: var(--on-light-cta);
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--border-on-light-subtle);
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 4px var(--shadow-card);
    transition: all 0.2s ease;
  }

  .navbar-cta:hover {
    color: var(--on-light-cta);
    transform: scale(1.03);
    box-shadow: 0 4px 12px var(--shadow-md);
  }

  :global(html.dark) .navbar-cta {
    background: var(--surface-white);
    color: var(--on-light-cta);
    border-color: var(--border-on-dark-subtle);
  }

  :global(html.dark) .navbar-cta:hover {
    background: transparent;
    color: var(--on-dark);
    transform: scale(1.03);
    box-shadow: 0 0 15px var(--glass-hi-soft);
  }

  .navbar-checkbox {
    display: none;
  }

  /* CAMBIO: flex-direction column para que los spans se apilen como hamburguesa real,
     gap en vez de margin para un espaciado más predecible */
  .navbar-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0.5rem;
  }

  .navbar-toggle span {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: var(--foreground-strong);
    border-radius: 999px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 1023px) {
    .navbar {
      padding: 1rem 1.25rem;
    }

    .navbar-toggle {
      display: flex;
      /* CAMBIO: se ubica después de navbar-actions para quedar a la derecha del ThemeToggle */
      order: 3;
    }

    /* CAMBIO: en vez de ocultar navbar-actions completo, se muestra solo el ThemeToggle
       y se reordena para que aparezca a la izquierda del botón hamburguesa */
    .navbar-actions {
      display: flex;
      order: 2;
      margin-left: auto;
    }

    .navbar-actions .navbar-cta {
      display: none;
    }

    .navbar-links {
      position: absolute;
      inset: 100% 0 auto 0;
      padding: 1rem 1.25rem 1.25rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      background: var(--surface-navbar-mobile);
      border-bottom-left-radius: 16px;
      border-bottom-right-radius: 16px;
      border-top: 1px solid var(--border-hairline);
      box-shadow: 0 12px 24px var(--shadow-color);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: max-height 0.25s ease, opacity 0.25s ease;
      text-align: center;
    }

    .navbar-links .navbar-cta {
      color: var(--on-light-cta);
      box-sizing: border-box;
      padding: 0.85rem 1.75rem;
      text-align: center;
    }

    .navbar-links a {
      padding: 0.75rem 0;
      display: block;
    }

    .navbar-cta {
      width: 100%;
    }

    .navbar-checkbox:checked + .navbar-toggle + .navbar-links {
      max-height: 420px;
      opacity: 1;
      pointer-events: auto;
    }
  }

  .mobile-cta {
    display: none;
  }

  :global(html.dark) .navbar-links a {
    color: var(--foreground-secondary);
  }

  :global(html.dark) .navbar-links a:hover {
    color: var(--brand-primary);
  }

  :global(html.dark) .navbar-toggle span {
    background: var(--foreground-secondary);
  }

  :global(html.dark) .navbar-links .navbar-cta {
    color: var(--on-light-cta);
  }
  @media (max-width: 1023px) {
    .mobile-cta {
      display: block;
    }
  }
</style>