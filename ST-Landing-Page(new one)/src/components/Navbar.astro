---
const navLinks = [
  { label: "Features", href: "#features" },
  { label: "How It Works", href: "#how-it-works" },
  { label: "Pricing", href: "#pricing" },
];
---

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/landing-logo.jpeg" alt="SafeTrust logo" width="32" height="32" />
    <span>SafeTrust</span>
  </a>

  <div class="navbar-links">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>

  <a href="#our-promise" class="navbar-cta">Connect Wallet</a>
</nav>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
  }
  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    color: inherit;
    text-decoration: none;
  }
  .navbar-brand img {
    border-radius: 6px;
  }
  .navbar-links {
    display: flex;
    gap: 1.5rem;
  }
  .navbar-links a {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }
  .navbar-cta {
    background: #2857B8;
    color: #fff;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
  }
</style>