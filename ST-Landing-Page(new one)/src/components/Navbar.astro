---
const navLinks = [
  { label: "Features", href: "#features" },
  { label: "How It Works", href: "#how-it-works" },
  { label: "Pricing", href: "#pricing" },
];
---

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/landing-logo.jpeg" alt="SafeTrust logo" width="32" height="32" />
    <span>SafeTrust</span>
  </a>

  <div class="navbar-links">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>

  <div class="navbar-actions">
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme" aria-pressed="false">🌙</button>
    <a href="/register" class="navbar-cta">Connect Wallet</a>
  </div>
</nav>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    gap: 1rem;
  }
  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--foreground);
    text-decoration: none;
  }
  .navbar-brand img {
    border-radius: 6px;
  }
  .navbar-links {
    display: flex;
    gap: 1.5rem;
  }
  .navbar-links a {
    color: var(--foreground);
    text-decoration: none;
    font-weight: 500;
  }
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .theme-toggle {
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--foreground);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px var(--shadow-color);
  }
  .navbar-cta {
    background: var(--brand-primary);
    color: #fff;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
  }
</style>