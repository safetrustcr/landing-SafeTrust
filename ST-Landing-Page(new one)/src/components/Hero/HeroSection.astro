---
import Navbar from "../Navbar.astro";
import TrustBadges from "./TrustBadges.astro";
import CTAButtons from "./CTAButtons.astro";
import EscrowCard from "./EscrowCard.tsx";
---

<section id="hero" class="hero-section" aria-label="Hero section - SafeTrust secure P2P transactions platform">
  <div class="background-visual" aria-hidden="true">
    <div class="gradient-mesh"></div>
    <div class="grid-pattern"></div>
  </div>

  <Navbar />

  <main id="main-content" class="hero-container">
    <div class="hero-content">
      <div class="badge fade-in">
        <span class="star-icon">★</span>
        <span>Live on Stellar mainnet</span>
      </div>

      <h1 class="hero-headline fade-in" style="animation-delay: 0.1s">
        Secure deposits. Zero intermediaries. P2P escrow you can
        <em class="highlight">actually trust.</em>
      </h1>

      <p class="hero-subheading fade-in" style="animation-delay: 0.2s">
        SafeTrust holds your funds in tamper-proof blockchain escrow on Stellar —
        automatically released when both parties agree. No banks, no middlemen, no risk.
      </p>

      <CTAButtons />
      <TrustBadges />
    </div>

    <div class="escrow-card-container" aria-hidden="true">
      <EscrowCard client:visible />
    </div>
  </main>

  <button id="scroll-indicator" class="scroll-indicator" aria-label="Scroll down to see more content">
    <span class="chevron">⌄</span>
  </button>
</section>

<style>
  .hero-section { position: relative; min-height: 100vh; overflow: hidden; background: var(--background); }
  .background-visual { position: absolute; inset: 0; z-index: -1; }
  .gradient-mesh {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(40,87,184,0.15), transparent 60%);
  }
  .grid-pattern {
    position: absolute; inset: 0;
    background-image: linear-gradient(var(--hero-grid) 1px, transparent 1px),
                      linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .hero-container { grid-template-columns: 1.2fr 1fr; align-items: center; }
  }
  .badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: linear-gradient(to right, var(--brand-tint), rgba(255,255,255,0.4));
    border: 1px solid var(--brand-tint-border);
    border-radius: 999px;
    font-size: 0.875rem; font-weight: 600;
    color: var(--brand-primary);
    margin-bottom: 1.5rem;
  }
  .hero-headline {
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }
  .highlight {
    background: linear-gradient(to right, #2857B8, #7c3aed);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-subheading {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--muted-foreground);
    max-width: 42rem;
    margin-top: 1.5rem;
    line-height: 1.6;
  }
  .escrow-card-container { display: flex; justify-content: center; }
  .scroll-indicator {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    background: none; border: none; cursor: pointer;
    font-size: 1.5rem;
    color: var(--scroll-indicator);
    animation: bounce 1.5s infinite;
  }

  .fade-in {
    animation: fadeInUp 0.6s ease-out both;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }
</style>

<script>
  document.getElementById("scroll-indicator")?.addEventListener("click", () => {
    document.getElementById("how-it-works")?.scrollIntoView({ behavior: "smooth" })
      ?? window.scrollTo({ top: window.innerHeight, behavior: "smooth" });
  });
</script>