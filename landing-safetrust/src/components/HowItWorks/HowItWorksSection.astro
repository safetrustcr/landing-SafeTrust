---
// src/components/HowItWorks/HowItWorksSection.astro
import Stepper from "./Stepper.jsx";

const STEPS = [
  { id: 1, stepLabel: "STEP 1", title: "Book & Deposit", description: "Funds are locked into the smart-contract escrow on booking.", status: "working", icon: "🔒" },
  { id: 2, stepLabel: "STEP 2", title: "Stay in Progress", description: "Funds are held on-chain securely while the stay is active.", status: "working", icon: "⚙️" },
  { id: 3, stepLabel: "STEP 3", title: "Check-out & Review", description: "Both parties confirm checkout to trigger the release.", status: "pendingRelease", icon: "🤝" },
  { id: 4, stepLabel: "STEP 4", title: "Funds Released", description: "Smart contract releases funds to the host automatically.", status: "released", icon: "💎" },
];

const STATUS_CONFIG = {
  working: { label: "working", bg: "rgba(219,234,254,1)", text: "#1d4ed8", ring: "#3b82f6" },
  pendingRelease: { label: "pendingRelease", bg: "rgba(254,243,199,1)", text: "#b45309", ring: "#f59e0b" },
  released: { label: "released", bg: "rgba(209,250,229,1)", text: "#065f46", ring: "#10b981" },
};
---

<section id="how-it-works" class="how-it-works">
  <div class="progress-bar" data-progress-bar></div>

  <div class="section-header" data-header>
    <h2>How It <span class="highlight">Works</span></h2>
    <p>Follow the escrow lifecycle — from booking to funds release — secured by blockchain at every step.</p>
  </div>

  <div class="timeline">
    {STEPS.map((step) => {
      const cfg = STATUS_CONFIG[step.status];
      return (
        <div class="step-node" data-step-node style="width: 160px;">
          <p class="step-label">{step.stepLabel}</p>
          <div class="node-circle" data-node-circle>
            <span class="node-icon" data-node-icon>{step.icon}</span>
          </div>
          <span
            class="status-chip"
            data-status-chip
            data-status={step.status}
            style={`background-color:${cfg.bg}; color:${cfg.text}; border:1px solid ${cfg.ring}`}
          >
            {cfg.label}
          </span>
          <p class="step-title">{step.title}</p>
          <p class="step-desc">{step.description}</p>
        </div>
      );
    })}

    {STEPS.slice(0, -1).map(() => (
      <div class="connector" data-connector>
        <div class="connector-glow" data-connector-glow></div>
      </div>
    ))}
  </div>

  <div class="cta">
    <p>Ready to secure your transactions?</p>
    <a href="#our-promise" class="cta-btn">Get Started →</a>
  </div>
</section>

<Stepper client:visible />

<style>
  .how-it-works { position: relative; padding: 5rem 1rem; }
  .progress-bar {
    position: absolute; top: 0; left: 0; height: 3px; width: 100%;
    background: #2857B8; transform-origin: left center; transform: scaleX(0);
  }
  .section-header { text-align: center; margin-bottom: 3.5rem; }
  .section-header h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; }
  .highlight { color: #2857B8; }
  .section-header p { color: var(--muted-foreground, #6b7280); max-width: 36rem; margin: 0.75rem auto 0; }

  .timeline {
    display: flex; align-items: flex-start; justify-content: center;
    flex-wrap: wrap; gap: 0;
    max-width: 1024px; margin: 0 auto;
  }
  .step-node { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .step-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: #9ca3af; margin-bottom: 0.75rem; }
  .node-circle {
    width: 72px; height: 72px; border-radius: 999px;
    border: 2px solid #2857B8; background: rgba(40,87,184,0.06);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 0.75rem;
  }
  .node-icon { font-size: 1.75rem; }
  .status-chip { display: inline-block; border-radius: 999px; padding: 0.1rem 0.75rem; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.5rem; }
  .step-title { font-weight: 700; font-size: 0.875rem; }
  .step-desc { font-size: 0.75rem; color: #6b7280; max-width: 130px; margin-top: 0.25rem; line-height: 1.5; }

  .connector {
    width: 48px; height: 2px; background: #d1d5db; margin: 36px 4px 0;
    position: relative; flex-shrink: 0;
    transform-origin: left center; transform: scaleX(0);
  }
  .connector-glow {
    position: absolute; inset: 0; opacity: 0;
    background: linear-gradient(90deg, transparent, #2857B8, transparent);
  }

  @media (max-width: 767px) {
    .timeline { flex-direction: column; align-items: center; }
    .connector { width: 2px; height: 36px; margin: 0; transform-origin: top center; transform: scaleY(0); }
    .step-node { width: 100% !important; max-width: 320px; flex-direction: row; text-align: left; gap: 1rem; }
    .step-desc { max-width: none; }
  }

  .cta { text-align: center; margin-top: 4rem; }
  .cta p { font-weight: 600; margin-bottom: 0.75rem; }
  .cta-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: #2857B8; color: #fff; font-weight: 600;
    padding: 0.75rem 1.5rem; border-radius: 0.5rem; text-decoration: none;
  }
</style>