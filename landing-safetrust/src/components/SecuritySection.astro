---
// SecuritySection.astro
import SecurityCard from './SecurityCard.astro';
import '../styles/security.css';
---

<section class="security-section">
  <!-- Heading Block -->
  <h2 class="security-title">SafeTrust security features</h2>
  <p class="security-subtitle">Multiple layers of protection — audited, certified, continuous.</p>

  <!-- Responsive Cards Grid -->
  <div class="security-grid">
    <SecurityCard
      title="End-to-end encryption"
      description="All data is encrypted in transit and at rest."
      iconType="lock"
      themeClass="theme-green"
      borderClass="border-primary"
      score="98/100"
      scoreColorClass="color-green"
      certs="ISO 27001 · SOC 2"
    />
    <SecurityCard
      title="Multi-factor authentication"
      description="User accounts are protected with multi-factor authentication."
      iconType="key"
      themeClass="theme-blue"
      borderClass="border-accent"
      score="95/100"
      scoreColorClass="color-blue"
      certs="GDPR · SOC 2"
    />
    <SecurityCard
      title="Real-time threat detection"
      description="Continuous monitoring and instant threat response."
      iconType="radar"
      themeClass="theme-navy"
      borderClass="border-primary"
      score="97/100"
      scoreColorClass="color-green"
      certs="ISO 27001"
    />
  </div>
</section>
