---
import Navbar from "../Navbar.astro";
import TrustBadges from "./TrustBadges.astro";
import CTAButtons from "./CTAButtons.astro";
import EscrowCard from "./EscrowCard.tsx";
---

<section id="hero" class="hero-section" aria-label="Hero section - SafeTrust secure P2P transactions platform">
  <div class="background-visual" aria-hidden="true">
    <div class="gradient-mesh"></div>
  </div>

  <Navbar />

  <main id="main-content" class="hero-container">
    <div class="hero-content">
      <div class="badge fade-in">
        <span class="star-icon">★</span>
        <span>Live on Stellar mainnet</span>
      </div>

      <h1 class="hero-headline fade-in" style="animation-delay: 0.1s">
        Secure deposits. Zero intermediaries. P2P escrow you can
        <em class="highlight">actually trust.</em>
      </h1>

      <p class="hero-subheading fade-in" style="animation-delay: 0.2s">
        SafeTrust holds your funds in tamper-proof blockchain escrow on Stellar —
        automatically released when both parties agree. No banks, no middlemen, no risk.
      </p>

      <CTAButtons />
      <TrustBadges />
    </div>

    <div class="escrow-card-container" aria-hidden="true">
      <EscrowCard client:visible />
    </div>
  </main>

  <button id="scroll-indicator" class="scroll-indicator" aria-label="Scroll down to see more content">
    <span class="chevron">⌄</span>
  </button>
</section>

<style>
  .hero-section { position: relative; min-height: 100vh; overflow: hidden; }
  .background-visual { position: absolute; inset: 0; z-index: -1; }
  .gradient-mesh {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 70% 10%, rgba(40, 87, 184, 0.13) 0%, transparent 70%),
      radial-gradient(ellipse 60% 50% at 10% 80%, rgba(124, 58, 237, 0.10) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 90% 85%, rgba(6, 182, 212, 0.07) 0%, transparent 60%),
      linear-gradient(160deg, #f8faff 0%, #f3f0ff 50%, #f0f7ff 100%);
  }
  .gradient-mesh::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 256px 256px;
    pointer-events: none;
  }
  :global(.dark .gradient-mesh) {
    background:
      radial-gradient(ellipse 80% 60% at 70% 10%, rgba(40, 87, 184, 0.20) 0%, transparent 70%),
      radial-gradient(ellipse 60% 50% at 10% 80%, rgba(124, 58, 237, 0.15) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 90% 85%, rgba(6, 182, 212, 0.10) 0%, transparent 60%),
      linear-gradient(160deg, #0f172a 0%, #0f172a 100%);
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .hero-container { grid-template-columns: 1.2fr 1fr; align-items: center; }
  }
  .badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: linear-gradient(to right, #eff6ff, #ecfeff);
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    font-size: 0.875rem; font-weight: 600;
    color: #0e7490;
    margin-bottom: 1.5rem;
  }
  .hero-headline {
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .highlight {
    background: linear-gradient(to right, #2857B8, #7c3aed);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-subheading {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--muted-foreground, #6b7280);
    max-width: 42rem;
    margin-top: 1.5rem;
    line-height: 1.6;
  }
  .escrow-card-container { display: flex; justify-content: center; }
  .scroll-indicator {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    background: none; border: none; cursor: pointer;
    font-size: 1.5rem;
    animation: bounce 1.5s infinite;
  }

  /* Fade-in entrance animation, replaces framer-motion */
  .fade-in {
    animation: fadeInUp 0.6s ease-out both;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }
</style>

<script>
  document.getElementById("scroll-indicator")?.addEventListener("click", () => {
    document.getElementById("how-it-works")?.scrollIntoView({ behavior: "smooth" })
      ?? window.scrollTo({ top: window.innerHeight, behavior: "smooth" });
  });
</script>