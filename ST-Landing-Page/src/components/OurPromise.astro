---
import ConnectWalletCTA from './ConnectWalletCTA';
import '../styles/our-promise.css';
---

<section class="our-promise" id="our-promise" aria-labelledby="our-promise-heading">
  <div class="our-promise__container">
    <div class="our-promise__left">
      <p class="our-promise__eyebrow">Our promise</p>
      <h2 class="our-promise__headline" id="our-promise-heading">
        Secure, transparent, <em>trusted.</em>
      </h2>
      <p class="our-promise__copy">
        Decentralized escrow that holds every deposit until both parties confirm. No middlemen,
        no surprises — just code you can verify yourself.
      </p>

      <div class="our-promise__actions">
        <ConnectWalletCTA client:load />
        <a class="our-promise__learn-more" href="#how-it-works">
          Learn more <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="our-promise__trust-pills">
        <li class="our-promise__trust-pill">
          <span class="our-promise__trust-icon our-promise__trust-icon--success" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          Bank-grade security
        </li>
        <li class="our-promise__trust-pill">
          <span class="our-promise__trust-icon our-promise__trust-icon--primary" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="2"></rect>
              <path d="M8 11V8a4 4 0 118 0v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </span>
          End-to-end encrypted
        </li>
        <li class="our-promise__trust-pill">
          <span class="our-promise__trust-icon our-promise__trust-icon--accent" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M12 3l2.2 6.8H21l-5.5 4 2.1 6.8L12 16.6 6.4 20.6l2.1-6.8L3 9.8h6.8L12 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
            </svg>
          </span>
          USDT protected
        </li>
      </ul>
    </div>

    <div class="our-promise__card-wrap">
      <div class="our-promise__verified-badge">
        <span class="our-promise__verified-label">Verified on-chain</span>
        <span class="our-promise__verified-version">v2.4 mainnet</span>
      </div>

      <article class="our-promise__card" aria-label="SafeTrust guarantees">
        <h3 class="our-promise__card-title">SafeTrust Guarantees</h3>

        <div class="our-promise__guarantee">
          <div class="our-promise__guarantee-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L4 6v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V6l-8-4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="our-promise__guarantee-body">
            <div class="our-promise__guarantee-row">
              <p class="our-promise__guarantee-name">Funds held in smart contract</p>
              <span class="our-promise__guarantee-tag">soroban</span>
            </div>
            <p class="our-promise__guarantee-desc">Not in our database. Not in a bank. In code.</p>
          </div>
        </div>

        <div class="our-promise__guarantee">
          <div class="our-promise__guarantee-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 3v18M7 8h10M9 13h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.5"></circle>
              <circle cx="17" cy="18" r="2" stroke="currentColor" stroke-width="1.5"></circle>
            </svg>
          </div>
          <div class="our-promise__guarantee-body">
            <div class="our-promise__guarantee-row">
              <p class="our-promise__guarantee-name">Released only on dual consent</p>
              <span class="our-promise__guarantee-tag">2/2 sig</span>
            </div>
            <p class="our-promise__guarantee-desc">Both buyer and seller must confirm. No exceptions.</p>
          </div>
        </div>

        <div class="our-promise__guarantee">
          <div class="our-promise__guarantee-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"></circle>
              <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M12 4v2M12 18v2M4 12h2M18 12h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </div>
          <div class="our-promise__guarantee-body">
            <div class="our-promise__guarantee-row">
              <p class="our-promise__guarantee-name">Transparent arbitration</p>
              <span class="our-promise__guarantee-tag">on-chain</span>
            </div>
            <p class="our-promise__guarantee-desc">Disputes resolved with verifiable evidence.</p>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
